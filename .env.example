# chati backend configuration (copy to backend/.env)

# Postgres connection (async SQLAlchemy URL)
DATABASE_URL=postgresql+asyncpg://chati:chati@127.0.0.1:5432/chati

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: a server-side key. You normally set the key from the app UI (Settings),
# which stores it in the database. Set this only if you prefer an env fallback.
# OPENROUTER_API_KEY=

# CORS origins for the dev server (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Context engineering
# Fraction of a model's context window that may be used for input.
CONTEXT_FRACTION=0.72
# Most-recent messages always kept verbatim (never compacted).
KEEP_RECENT_MESSAGES=8
# Rough chars-per-token used for budgeting.
CHARS_PER_TOKEN=3.6
